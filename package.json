{
  "name": "njmca-members",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm fallow:audit",
    "db:app:migrate": "node scripts/db/apply-app-sql.mjs migrate",
    "db:app:reset": "node scripts/db/apply-app-sql.mjs reset",
    "db:app:seed": "node scripts/db/apply-app-sql.mjs seed",
    "db:auth:generate": "node scripts/db/run-auth-cli.mjs generate --output src/server/better-auth-schema.sql",
    "db:auth:migrate": "node scripts/db/run-auth-cli.mjs migrate",
    "db:local:destroy": "node scripts/db/compose.mjs down -v",
    "db:local:down": "node scripts/db/compose.mjs down",
    "db:local:migrate": "pnpm db:auth:migrate && pnpm db:app:reset",
    "db:local:up": "node scripts/db/compose.mjs up -d postgres",
    "dev": "node scripts/dev/run-with-local-env.mjs vite dev --host 127.0.0.1 --port 4280 --strictPort",
    "fallow": "fallow",
    "fallow:audit": "fallow audit --base origin/main",
    "fallow:fix": "fallow fix --dry-run",
    "fallow:hooks": "node scripts/dev/install-git-hooks.mjs --force",
    "lint": "eslint .",
    "prepare": "node scripts/dev/install-git-hooks.mjs",
    "preview": "node scripts/dev/run-with-local-env.mjs vite preview --host 127.0.0.1 --port 4280",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/roboto": "5.3.0",
    "@mui/icons-material": "^6.4.7",
    "@mui/material": "^6.4.7",
    "@tanstack/react-router": "1.170.29",
    "@tanstack/react-start": "1.168.46",
    "better-auth": "^1.6.11",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "fallow": "^3.17.0",
    "typescript": "^5.4.5",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
